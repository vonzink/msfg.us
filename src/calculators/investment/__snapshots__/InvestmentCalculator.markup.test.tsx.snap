ue="500,000"/></div></div><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-grossRents" class="text-[13px] font-semibold">Monthly rent</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><span aria-hidden="true" class="pl-2.5 text-[15px] font-semibold text-muted">$</span><input id="reo-grossRents" type="text" inputMode="decimal" autoComplete="off" placeholder="0" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="3,780"/></div></div><div class="flex min-w-0 flex-col gap-1.5 opacity-60"><label for="reo-downPct" class="text-[13px] font-semibold">Down payment</label><div class="flex items-center rounded-md border transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line bg-paper-2"><input id="reo-downPct" type="text" inputMode="decimal" autoComplete="off" placeholder="0" disabled="" aria-describedby="reo-downPct-hint" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="20"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div><input type="range" aria-label="Down payment" min="0" max="100" step="1" disabled="" class="mt-0.5 w-full accent-spring-2 disabled:cursor-not-allowed print:hidden" value="20"/><span id="reo-downPct-hint" class="text-[12px] text-muted print:hidden">Not used when paying all cash.</span></div><div class="flex min-w-0 flex-col gap-1.5 opacity-60"><label for="reo-rate" class="text-[13px] font-semibold">Interest rate</label><div class="flex items-center rounded-md border transition-shadow focus-within:bor