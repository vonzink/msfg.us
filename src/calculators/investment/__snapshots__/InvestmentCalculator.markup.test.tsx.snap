ex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><span aria-hidden="true" class="pl-2.5 text-[15px] font-semibold text-muted">$</span><input id="reo-otherExp" type="text" inputMode="decimal" autoComplete="off" placeholder="0" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value=""/></div></div><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-vacancy" class="text-[13px] font-semibold">Vacancy</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-vacancy" type="text" inputMode="decimal" autoComplete="off" placeholder="0" aria-describedby="reo-vacancy-hint" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="5"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div><input type="range" aria-label="Vacancy" min="0" max="25" step="1" class="mt-0.5 w-full accent-spring-2 disabled:cursor-not-allowed print:hidden" value="5"/><span id="reo-vacancy-hint" class="text-[12px] text-muted print:hidden">Share of the year the home sits empty.</span></div></div></div></details><details data-calc-panel="true" class="group rounded-xl border border-line bg-white shadow-card print:shadow-none print:break-inside-avoid"><summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-5 py-4 max-[600px]:px-4 [&amp;::-webkit-details-marker]:hidden"><span class="text-[17px] font-bold">Add detail</span><span aria-hidden="true" class="ml-auto size-2.5 flex-none -translate-y-0.5 rotate-45 border-b-2 border-r-2 border-muted transition-transform group-open:translate-y-0.5 group-open:-rotate-135 print:hidden"></span></summary><div class="px-5 pb-5 pt-1 max-[600px]:px-4"><div class="grid gap-3.5"><details data-calc-panel="true" class="rounded-xl border border-line bg-white shadow-card print:shadow-none print:break-inside-avoid group/detail"><summary class="flex cursor-pointer list-none items-baseline gap-3 rounded-xl px-5 py-4 max-[600px]:px-4 [&amp;::-webkit-details-marker]:hidden"><span class="text-[17px] font-bold">Growth and sale</span><span class="ml-auto text-right text-[14px] tabular-nums text-muted">3% appreciation</span><span aria-hidden="true" class="ml-1 size-2.5 flex-none -translate-y-0.5 rotate-45 self-center border-b-2 border-r-2 border-muted transition-transform group-open/detail:translate-y-0.5 group-open/detail:-rotate-135 print:hidden"></span></summary><div class="px-5 pb-5 pt-1 max-[600px]:px-4"><p class="mb-3.5 text-[14px] text-muted">Yearly changes used for the five-year projection.</p><div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-x-4 gap-y-3.5"><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-appreciation" class="text-[13px] font-semibold">Home appreciation</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-appreciation" type="text" inputMode="decimal" autoComplete="off" placeholder="0" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="3"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div><input type="range" aria-label="Home appreciation" min="0" max="10" step="0.5" class="mt-0.5 w-full accent-spring-2 disabled:cursor-not-allowed print:hidden" value="3"/></div><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-rentIncrease" class="text-[13px] font-semibold">Rent increase</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-rentIncrease" type="text" inputMode="decimal" autoComplete="off" placeholder="0" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="2.5"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div></div><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-expIncrease" class="text-[13px] font-semibold">Expense increase</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-expIncrease" type="text" inputMode="decimal" autoComplete="off" placeholder="0" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="2.5"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div></div><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-sellCostPct" class="text-[13px] font-semibold">Selling costs</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-sellCostPct" type="text" inputMode="decimal" autoComplete="off" placeholder="0" aria-describedby="reo-sellCostPct-hint" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="6"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div><span id="reo-sellCostPct-hint" class="text-[12px] text-muted print:hidden">Agent fees and closing when you sell.</span></div></div></div></details><details data-calc-panel="true" class="rounded-xl border border-line bg-white shadow-card print:shadow-none print:break-inside-avoid group/detail"><summary class="flex cursor-pointer list-none items-baseline gap-3 rounded-xl px-5 py-4 max-[600px]:px-4 [&amp;::-webkit-details-marker]:hidden"><span class="text-[17px] font-bold">Income taxes</span><span class="ml-auto text-right text-[14px] tabular-nums text-muted">24% bracket</span><span aria-hidden="true" class="ml-1 size-2.5 flex-none -translate-y-0.5 rotate-45 self-center border-b-2 border-r-2 border-muted transition-transform group-open/detail:translate-y-0.5 group-open/detail:-rotate-135 print:hidden"></span></summary><div class="px-5 pb-5 pt-1 max-[600px]:px-4"><p class="mb-3.5 text-[14px] text-muted">Used to estimate the tax you owe, or save, on the rental each year.</p><div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-x-4 gap-y-3.5"><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-taxBracket" class="text-[13px] font-semibold">Your tax bracket</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-taxBracket" type="text" inputMode="decimal" autoComplete="off" placeholder="0" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="24"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div></div><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-improvePct" class="text-[13px] font-semibold">Building share of value</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-improvePct" type="text" inputMode="decimal" autoComplete="off" placeholder="0" aria-describedby="reo-improvePct-hint" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="80"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div><span id="reo-improvePct-hint" class="text-[12px] text-muted print:hidden">Land cannot be depreciated. 70 to 85 is typical.</span></div><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-deprYears" class="text-[13px] font-semibold">Depreciation period</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-deprYears" type="text" inputMode="decimal" autoComplete="off" placeholder="0" aria-describedby="reo-deprYears-hint" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="27.5"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">yrs</span></div><span id="reo-deprYears-hint" class="text-[12px] text-muted print:hidden">27.5 years for residential rentals.</span></div><fieldset class="col-span-full m-0 flex min-w-0 flex-col gap-1.5 border-0 p-0"><legend class="mb-1.5 p-0 text-[13px] font-semibold">Can you deduct rental losses from your other income?</legend><div class="grid auto-cols-fr grid-flow-col gap-[3px] rounded-md bg-paper-2 p-[3px]"><label class="relative cursor-pointer rounded-sm px-1.5 py-2 text-center text-[14px] font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-spring-2 text-muted"><input type="radio" class="absolute inset-0 cursor-pointer opacity-0" name="reo-lossesNow" value="yes"/>Yes, each year</label><label class="relative cursor-pointer rounded-sm px-1.5 py-2 text-center text-[14px] font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-spring-2 bg-green-600 text-white shadow-3d"><input type="radio" class="absolute inset-0 cursor-pointer opacity-0" name="reo-lossesNow" checked="" value="no"/>No, hold them</label></div><span class="text-[12px] text-muted print:hidden">Usually only if your income is under $150,000, and in full only under $100,000. If not, a loss waits for later rental profit or the sale. Ask your tax advisor.</span></fieldset><fieldset class="col-span-full m-0 flex min-w-0 flex-col gap-1.5 border-0 p-0"><legend class="mb-1.5 p-0 text-[13px] font-semibold">Tax when you sell</legend><div class="grid auto-cols-fr grid-flow-col gap-[3px] rounded-md bg-paper-2 p-[3px]"><label class="relative cursor-pointer rounded-sm px-1.5 py-2 text-center text-[14px] font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-spring-2 text-muted"><input type="radio" class="absolute inset-0 cursor-pointer opacity-0" name="reo-saleTax" value="none"/>Leave out</label><label class="relative cursor-pointer rounded-sm px-1.5 py-2 text-center text-[14px] font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-spring-2 bg-green-600 text-white shadow-3d"><input type="radio" class="absolute inset-0 cursor-pointer opacity-0" name="reo-saleTax" checked="" value="long"/>Long-term gain</label><label class="relative cursor-pointer rounded-sm px-1.5 py-2 text-center text-[14px] font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-spring-2 text-muted"><input type="radio" class="absolute inset-0 cursor-pointer opacity-0" name="reo-saleTax" value="short"/>Short-term gain</label></div><span class="text-[12px] text-muted print:hidden">Long-term rates need more than a year of ownership. Either way, the depreciation you took is taxed again when you sell.</span></fieldset><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-capGainsRate" class="text-[13px] font-semibold">Long-term gains rate</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-capGainsRate" type="text" inputMode="decimal" autoComplete="off" placeholder="0" aria-describedby="reo-capGainsRate-hint" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="15"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div><span id="reo-capGainsRate-hint" class="text-[12px] text-muted print:hidden">0, 15 or 20 for most people.</span></div></div></div></details><details data-calc-panel="true" class="rounded-xl border border-line bg-white shadow-card print:shadow-none print:break-inside-avoid group/detail"><summary class="flex cursor-pointer list-none items-baseline gap-3 rounded-xl px-5 py-4 max-[600px]:px-4 [&amp;::-webkit-details-marker]:hidden"><span class="text-[17px] font-bold">Opportunity cost</span><span class="ml-auto text-right text-[14px] tabular-nums text-muted">vs 4% a year</span><span aria-hidden="true" class="ml-1 size-2.5 flex-none -translate-y-0.5 rotate-45 self-center border-b-2 border-r-2 border-muted transition-transform group-open/detail:translate-y-0.5 group-open/detail:-rotate-135 print:hidden"></span></summary><div class="px-5 pb-5 pt-1 max-[600px]:px-4"><p class="mb-3.5 text-[14px] text-muted">See how the property stacks up against putting the same cash somewhere else.</p><div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-x-4 gap-y-3.5"><fieldset class="col-span-full m-0 flex min-w-0 flex-col gap-1.5 border-0 p-0"><legend class="mb-1.5 p-0 text-[13px] font-semibold">Compare with another investment</legend><div class="grid auto-cols-fr grid-flow-col gap-[3px] rounded-md bg-paper-2 p-[3px]"><label class="relative cursor-pointer rounded-sm px-1.5 py-2 text-center text-[14px] font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-spring-2 text-muted"><input type="radio" class="absolute inset-0 cursor-pointer opacity-0" name="reo-compareAlt" value="off"/>Off</label><label class="relative cursor-pointer rounded-sm px-1.5 py-2 text-center text-[14px] font-semibold has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-spring-2 bg-green-600 text-white shadow-3d"><input type="radio" class="absolute inset-0 cursor-pointer opacity-0" name="reo-compareAlt" checked="" value="on"/>On</label></div></fieldset><div class="flex min-w-0 flex-col gap-1.5"><label for="reo-altReturn" class="text-[13px] font-semibold">Return elsewhere</label><div class="flex items-center rounded-md border bg-white transition-shadow focus-within:border-spring-2 focus-within:shadow-[0_0_0_3px_var(--color-spring-soft)] border-line"><input id="reo-altReturn" type="text" inputMode="decimal" autoComplete="off" placeholder="0" aria-describedby="reo-altReturn-hint" class="w-full min-w-0 flex-1 border-0 bg-transparent px-2.5 py-2.5 text-[16px] font-semibold tabular-nums text-ink outline-none placeholder:font-normal placeholder:text-muted/60 disabled:cursor-not-allowed" value="4"/><span aria-hidden="true" class="pr-2.5 text-[15px] font-semibold text-muted">%</span></div><span id="reo-altReturn-hint" class="text-[12px] text-muted print:hidden">Yearly after-tax return you could expect, such as from an index fund.</span></div></div></div></details></div></div></details><p class="mx-1 text-[13px] text-muted print:hidden">3% appreciation, 24% bracket, vs 4% a year</p></form><section id="reo-results" aria-label="Results" class="grid scroll-mt-24 gap-4 print:mt-4 [@media(min-width:981px)_and_(min-height:1000px)]:sticky [@media(min-width:981px)_and_(min-height:1000px)]:top-24"><div class="rounded-xl bg-green-800 p-6 text-on-dark shadow-card print:border print:border-ink print:bg-transparent print:text-ink print:shadow-none"><p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-mint print:text-muted">Five-year after-tax return</p><p aria-live="polite" class="mt-1 text-[clamp(40px,5vw,58px)] font-extrabold leading-[1.05] tracking-[-0.02em] tabular-nums print:text-ink text-white">$147,032</p><p class="mt-1.5 text-[16px] text-on-dark-2 print:text-ink"><strong class="text-white print:text-ink">28.3%</strong> on <strong class="text-white print:text-ink">$519,000</strong> cash invested</p><p class="mt-1 text-[14px] text-on-dark-2 print:text-ink">After $21,502 tax on the sale at long-term rates.</p><p class="mt-3 rounded-md bg-green-900 px-3 py-2 text-[15px] print:border print:border-line print:bg-transparent"><strong class="print:text-ink text-mint">$34,589 ahead of</strong> the same cash earning 4% a year, which would have made $112,443.</p><p class="mt-4 border-t border-hair-dark pt-3.5 text-[15px] print:border-line">On these assumptions, the rent covers the bills with about $2,166 a month left over in year 1. Selling after year 2 would get back more than you put in. It would beat 4% a year after year 3.</p></div><div class="grid grid-cols-4 gap-3 max-[600px]:grid-cols-2"><div class="flex min-w-0 flex-col gap-0.5 rounded-lg border border-line bg-white p-3.5 print:break-inside-avoid"><span class="flex items-center gap-1.5 text-[12px] font-semibold text-muted">Monthly cash flow<button type="button" aria-label="Monthly cash flow: Rent collected minus expenses and the mortgage payment, averaged over year 1, before income tax. Dial: Higher keeps 10% or more of the rent, Middle keeps less than that, Lower loses money." class="group/tip relative size-4 flex-none cursor-help rounded-full border border-line bg-white text-[10px] font-bold leading-none text-muted print:hidden">?<span role="tooltip" class="pointer-events-none absolute bottom-[calc(100%+8px)] left-1/2 z-[5] hidden w-[220px] -translate-x-1/2 rounded-md bg-green-900 px-3 py-2.5 text-left text-[13px] font-normal leading-snug text-white shadow-3d group-hover/tip:block group-focus/tip:block">Rent collected minus expenses and the mortgage payment, averaged over year 1, before income tax. Dial: Higher keeps 10% or more of the rent, Middle keeps less than that, Lower loses money.</span></button></span><div class="mt-2 flex flex-col items-center gap-0.5 text-center"><svg viewBox="0 0 120 68" aria-hidden="true" class="block h-auto w-full max-w-[150px]"><path d="M12.00,60.00A48,48 0 0 1 35.22,18.89" fill="none" stroke-width="11" class="stroke-loss opacity-30"></path><path d="M36.79,17.99A48,48 0 0 1 83.21,17.99" fill="none" stroke-width="11" class="stroke-chart-4 opacity-30"></path><path d="M84.78,18.89A48,48 0 0 1 108.00,60.00" fill="none" stroke-width="11" class="stroke-chart-3"></path><g class="transition-transform duration-500 ease-out motion-reduce:transition-none" style="transform:rotate(90deg);transform-origin:60px 60px;transform-box:view-box"><line x1="60" y1="60" x2="60" y2="22" stroke-width="3" stroke-linecap="round" class="stroke-ink"></line></g><circle cx="60" cy="60" r="5" class="fill-ink"></circle></svg><span class="mt-1 text-[22px] font-extrabold tabular-nums tracking-[-0.01em]">$2,166</span><span class="inline-flex items-center gap-1.5 text-[13px] font-bold"><span class="sr-only">Rating:</span><i aria-hidden="true" class="inline-block size-2.5 rounded-full bg-chart-3"></i>Higher</span><span class="text-[12px] text-muted">Year 1 average, before taxes</span></div></div><div class="flex min-w-0 flex-col gap-0.5 rounded-lg border border-line bg-white p-3.5 print:break-inside-avoid"><span class="flex items-center gap-1.5 text-[12px] font-semibold text-muted">Cash-on-cash<button type="button" aria-label="Cash-on-cash: Year-1 cash flow divided by the cash you put in. It ignores appreciation and loan paydown. Dial: Higher is 8% or more, Middle 4% to 8%, Lower under 4%." class="group/tip relative size-4 flex-none cursor-help rounded-full border border-line bg-white text-[10px] font-bold leading-none text-muted print:hidden">?<span role="tooltip" class="pointer-events-none absolute bottom-[calc(100%+8px)] left-1/2 z-[5] hidden w-[220px] -translate-x-1/2 rounded-md bg-green-900 px-3 py-2.5 text-left text-[13px] font-normal leading-snug text-white shadow-3d group-hover/tip:block group-focus/tip:block">Year-1 cash flow divided by the cash you put in. It ignores appreciation and loan paydown. Dial: Higher is 8% or more, Middle 4% to 8%, Lower under 4%.</span></button></span><div class="mt-2 flex flex-col items-center gap-0.5 text-center"><svg viewBox="0 0 120 68" aria-hidden="true" class="block h-auto w-full max-w-[150px]"><path d="M12.00,60.00A48,48 0 0 1 35.22,18.89" fill="none" stroke-width="11" class="stroke-loss opacity-30"></path><path d="M36.79,17.99A48,48 0 0 1 83.21,17.99" fill="none" stroke-width="11" class="stroke-chart-4"></path><path d="M84.78,18.89A48,48 0 0 1 108.00,60.00" fill="none" stroke-width="11" class="stroke-chart-3 opacity-30"></path><g class="transition-transform duration-500 ease-out motion-reduce:transition-none" style="transform:rotate(-14.884393063583815deg);transform-origin:60px 60px;transform-box:view-box"><line x1="60" y1="60" x2="60" y2="22" stroke-width="3" stroke-linecap="round" class="stroke-ink"></line></g><circle cx="60" cy="60" r="5" class="fill-ink"></circ